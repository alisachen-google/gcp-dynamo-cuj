%% Rendered with Mermaid 10.9.3. Solid edges: requests/work; dashed edges: metadata.
flowchart TB
    accTitle: How Dynamo chooses a worker using reusable prefixes and active load
    accDescr: Worker cache events populate a prefix index. The router combines that metadata with active load and the incoming request. It can choose a worker with a reusable prefix or a less busy worker without one. Cached tensors remain in the serving engines.

    EVENTS["Worker cache events<br/>block insertion / eviction"] -.-> INDEX["Prefix index<br/>block hashes → worker locations"]
    REQUEST["Incoming request<br/>shared prefix P + new tokens"] --> ROUTER
    INDEX -. "prefix overlap" .-> ROUTER["Dynamo KV-aware router<br/>Score eligible workers<br/>using reuse and projected load"]
    LOAD["Active-load tracker<br/>assigned prefill / decode work"] -. "load estimate" .-> ROUTER
    ROUTER -->|"reuse when load permits"| WARM["Worker A: prefix P resident<br/>Reuse valid P state<br/>Prefill uncached suffix"]
    ROUTER -->|"lower load can outweigh reuse"| COLD["Worker B: no matching P<br/>Prefill missing prefix<br/>and suffix"]
    WARM --> GENERATE["Continue generation<br/>Agg: decode on the selected worker<br/>Disagg: transfer state to a decode worker"]
    COLD --> GENERATE

    classDef request fill:#e8f0fe,stroke:#2463b3,color:#163d72,stroke-width:1.5px;
    classDef metadata fill:#f2effa,stroke:#7d75b7,color:#493e70,stroke-width:1.5px;
    classDef router fill:#173b63,stroke:#173b63,color:#ffffff,stroke-width:2px;
    classDef warm fill:#e6f4ed,stroke:#16836b,color:#135e4c,stroke-width:1.5px;
    classDef cold fill:#fff1e8,stroke:#d65b29,color:#89401f,stroke-width:1.5px;
    classDef output fill:#edf3f9,stroke:#738aa2,color:#162b45,stroke-width:1.5px;
    class REQUEST request;
    class EVENTS,INDEX,LOAD metadata;
    class ROUTER router;
    class WARM warm;
    class COLD cold;
    class GENERATE output;
