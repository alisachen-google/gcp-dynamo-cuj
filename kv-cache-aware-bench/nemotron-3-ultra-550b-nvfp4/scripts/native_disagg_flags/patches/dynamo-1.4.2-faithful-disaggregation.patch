+#[test]
+fn private_decode_state_slots_include_transferring_and_activated_requests() {
+    let mut args = test_args(128, 4, 16);
+    args.worker_type = crate::common::protocols::WorkerType::Decode;
+    args.max_num_seqs = Some(5);
