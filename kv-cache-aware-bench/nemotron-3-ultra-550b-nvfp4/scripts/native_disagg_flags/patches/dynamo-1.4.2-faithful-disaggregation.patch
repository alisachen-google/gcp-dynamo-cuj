+    let mut core = SglangCore::new(args);
+    let ids: Vec<_> = (1..=6).map(|n| HandoffId::from(Uuid::from_u128(n))).collect();
+    for (index, id) in ids.iter().enumerate() {
+        let effects = core.apply_command_effects(SchedulerCommand::ReserveDestination {
+            handoff_id: *id,
+            request: direct_request(vec![index as u32; 8], 4),
