+        assert_eq!(effects.lifecycle_events.len(), usize::from(index < 5));
+    }
+    assert!(core.destination_indices(ids[5]).is_empty());
+    core.apply_command(SchedulerCommand::ActivateDestination { handoff_id: ids[0] }).unwrap();
+    assert!(core.retry_pending_destinations().is_empty());
+    let effects = core.apply_command_effects(
+        SchedulerCommand::CancelDestination { handoff_id: ids[0] }, true,
+    ).unwrap();
+    assert_eq!(effects.lifecycle_events.len(), 1);
+    assert_eq!(core.destination_indices(ids[5]).len(), 8);
+    for id in &ids[1..] {
