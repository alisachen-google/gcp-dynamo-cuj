+    #[case] evict_state: bool,
+) {
+    let mut args = test_args(32, 64, 512);
+    let sg = args.sglang.as_mut().unwrap();
+    sg.enable_mixed_chunk = Some(false);
+    sg.mamba_state_capacity = Some(10);
+    sg.mamba_track_interval = Some(256);
+    let mut core = SglangCore::new(args);
+    let first: Vec<u32> = (0..128).collect();
+    let second: Vec<u32> = (1000..1128).collect();
+    core.receive(direct_request(first.clone(), 2));
+    let pass = core.execute_pass_internal(None, 0.0);
+    assert_eq!(pass.output_signals.len(), 1);
+    core.receive(direct_request(second.clone(), 1));
+    let pass = core.execute_pass_internal(None, pass.end_ms);
+    assert_eq!(pass.output_signals.len(), 1);
+    assert_eq!(core.kv_manager.cache().prefix_match_len(&second), 128);
+    let pass = core.execute_pass_internal(None, pass.end_ms);
+    assert_eq!(pass.output_signals.len(), 1);
+    assert!(core.running.is_empty());
+
+    // First completed later, but it never crossed a decode checkpoint boundary.
+    // It must release its lease without promoting the old prefill checkpoint.
