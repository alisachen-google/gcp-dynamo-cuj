+#[rstest]
+#[case(32, 0)]
+#[case(40, 8)]
+#[case(56, 8)]
+fn chunked_prefill_reuses_cached_prefix_beyond_first_chunk(
+    #[case] prompt_len: usize,
+    #[case] computed: usize,
+) {
+    let config = SglangConfig::from_args(&test_args(32, 4, 8));
+    let mut kv_manager = SglangKvManager::new(128, 4, KvEventPublishers::default(), 0);
+    let cached_prompt: Vec<u32> = (0..32).collect();
+    let cached = kv_manager.allocate_for_request(&cached_prompt).unwrap();
+    let cached_indices = cached.lease.indices().to_vec();
+    kv_manager.finish(&cached_prompt, cached.lease);
+    let prompt: Vec<u32> = (0..prompt_len as u32).collect();
+    let mut waiting = VecDeque::from([SglangRequest::from(direct_request(prompt, 1))]);
+
+    let batch = get_new_batch_prefill(&mut waiting, &mut kv_manager, &config, 0.7, &[]);
+
+    assert_eq!(batch.can_run.len(), 1);
+    assert_eq!(batch.admissions[0].reused_input_tokens, 32);
+    assert_eq!(batch.prefill_fpm[0].tokens_computed, computed);
+    let req = &batch.can_run[0];
+    assert_eq!(req.materialized_tokens, 32 + computed);
+    assert_eq!(&req.kv_indices()[..32], cached_indices);
+    assert_eq!(req.extend_input_len(), prompt_len - 32 - computed);
+    assert!(waiting.is_empty());
