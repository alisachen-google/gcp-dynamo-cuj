+#[test]
+fn hybrid_prefill_survives_eviction_of_its_cached_longer_descendant() {
+    let mut args = test_args(128, 4, 64);
+    let sg = args.sglang.as_mut().unwrap();
+    sg.enable_mixed_chunk = Some(false);
+    sg.mamba_state_capacity = Some(8);
+    let mut core = SglangCore::new(args);
+    let mut now = 0.0;
+    for offset in [0, 100, 200, 300, 400] {
+        core.receive(direct_request((offset..offset + 24).collect(), 1));
+        let pass = core.execute_pass_internal(None, now);
+        now = pass.end_ms;
+        assert!(core.is_empty());
+    }
+    let mut branch = direct_request((0..12).collect(), 5);
+    branch.output_token_ids = Some((2000..2005).collect());
+    core.receive(branch);
+    let mut outputs = 0;
+    while !core.is_empty() {
+        let pass = core.execute_pass_internal(None, now);
+        now = pass.end_ms;
+        outputs += pass
+            .output_signals
+            .iter()
+            .filter(|s| s.token_id.is_some())
+            .count();
+    }
+    assert_eq!(outputs, 5);
+    assert_eq!(
+        core.kv_manager
+            .cache()
+            .prefix_match_len(&(0..24).collect::<Vec<_>>()),
+        12
+    );
+}
