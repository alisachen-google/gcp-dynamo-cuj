+#[test]
+fn hybrid_concurrent_branch_pressure_preserves_leases() {
+    let mut args = test_args(128, 4, 8);
+    args.max_num_seqs = Some(3);
+    let sg = args.sglang.as_mut().unwrap();
+    sg.enable_mixed_chunk = Some(false);
+    sg.mamba_state_capacity = Some(16);
+    let mut core = SglangCore::new(args);
+    let mut now = 0.0;
+    for round in 0..200 {
+        let mut ids = Vec::new();
+        for branch in 0..3 {
+            let length = 32 + (round + branch * 7) % 25;
+            let mut tokens: Vec<u32> = (0..length as u32).collect();
+            tokens[12 + (round + branch) % 16] = 100 + (round % 5) as u32;
+            ids.push(core.receive(direct_request(tokens, 1 + (round + branch) % 11)));
+        }
+        let mut steps = 0;
+        while !core.is_empty() {
+            let pass = core.execute_pass_internal(None, now);
+            now = pass.end_ms;
+            if steps == 2 && round % 4 == 0 {
+                core.apply_command(SchedulerCommand::CancelRequest { request_id: ids[1] })
+                    .unwrap();
+            }
+            steps += 1;
+            assert!(
+                steps < 100,
+                "finite-state branch traffic must make progress"
+            );
+        }
     }
