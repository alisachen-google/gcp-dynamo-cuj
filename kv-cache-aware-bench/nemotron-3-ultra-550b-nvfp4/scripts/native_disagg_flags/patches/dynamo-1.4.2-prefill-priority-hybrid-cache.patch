+#[test]
+fn hybrid_state_pool_survives_repeated_branch_replay_and_cancellation() {
+    let mut args = test_args(128, 4, 8);
+    args.max_num_seqs = Some(2);
+    let sg = args.sglang.as_mut().unwrap();
+    sg.enable_mixed_chunk = Some(false);
+    sg.mamba_state_capacity = Some(16);
+    let mut core = SglangCore::new(args);
+    let mut now = 0.0;
+    for turn in 0..80 {
+        let mut tokens: Vec<u32> = (0..20).collect();
+        tokens[12] = 100 + turn % 7;
+        core.receive(direct_request(tokens, 5));
+        let mut steps = 0;
+        while !core.is_empty() {
+            let pass = core.execute_pass_internal(None, now);
+            now = pass.end_ms;
+            steps += 1;
+            assert!(steps < 20, "state capacity must be reclaimed on completion");
+        }
+        let request_id = core.receive(direct_request((200..220).collect(), 100));
+        let pass = core.execute_pass_internal(None, now);
+        now = pass.end_ms;
+        core.apply_command(SchedulerCommand::CancelRequest { request_id })
+            .unwrap();
+        assert!(core.is_empty());
     }
