+#[test]
+fn hybrid_cache_keeps_decode_checkpoints_private_until_completion() {
+    let mut args = test_args(128, 4, 4);
+    let sg = args.sglang.as_mut().unwrap();
+    sg.enable_mixed_chunk = Some(false);
+    sg.mamba_state_capacity = Some(16);
+    let mut core = SglangCore::new(args);
+    let mut request = direct_request((0..8).collect(), 10);
+    request.output_token_ids = Some((100..110).collect());
+    core.receive(request);
+    let mut now = 0.0;
+    for _ in 0..6 {
+        let pass = core.execute_pass_internal(None, now);
+        now = pass.end_ms;
+    }
+    let sequence = core.running[0].sequence_tokens().to_vec();
+    assert!(sequence.len() >= 12);
+    assert_eq!(
+        core.kv_manager.cache().prefix_match_len(&sequence),
+        8,
+        "generated tokens must not expose live private Mamba checkpoints"
+    );
+    while !core.is_empty() {
+        let pass = core.execute_pass_internal(None, now);
+        now = pass.end_ms;
+    }
+    let full: Vec<u32> = (0..8).chain(100..110).collect();
+    assert_eq!(core.kv_manager.cache().prefix_match_len(&full), 16);
+    assert_eq!(core.kv_manager.cache().prefix_match_len(&full[..12]), 8);
+}
