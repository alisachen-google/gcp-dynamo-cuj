+#[test]
+fn prefill_priority_pauses_existing_decodes_across_chunks() {
+    let mut args = test_args(128, 4, 8);
+    args.sglang.as_mut().unwrap().enable_mixed_chunk = Some(false);
+    let mut core = SglangCore::new(args);
+    let first = core.receive(direct_request(vec![1, 2, 3, 4], 4));
+    let pass = core.execute_pass_internal(None, 0.0);
+    assert_eq!(pass.output_signals.len(), 1);
+    assert_eq!(pass.output_signals[0].uuid, first);
+    assert_eq!(pass.fpm.as_ref().unwrap().num_decode_requests, 0);
+    let second = core.receive(direct_request((100..120).collect(), 3));
+    let mut now = pass.end_ms;
+    for _ in 0..2 {
+        let pass = core.execute_pass_internal(None, now);
+        assert!(
+            pass.output_signals.is_empty(),
+            "existing decode must pause during a prefill chunk"
+        );
+        assert_eq!(pass.fpm.as_ref().unwrap().num_decode_requests, 0);
+        now = pass.end_ms;
+    }
+    let pass = core.execute_pass_internal(None, now);
+    assert_eq!(pass.output_signals.len(), 1);
+    assert_eq!(pass.output_signals[0].uuid, second);
+    assert_eq!(pass.fpm.as_ref().unwrap().num_decode_requests, 0);
+    let pass = core.execute_pass_internal(None, pass.end_ms);
+    assert_eq!(pass.output_signals.len(), 2);
+    assert_eq!(pass.fpm.as_ref().unwrap().num_decode_requests, 2);
+}
