+#[test]
+fn hybrid_prefill_tracks_a_recomputed_branch_point() {
+    let mut args = test_args(256, 64, 256);
+    let sg = args.sglang.as_mut().unwrap();
+    sg.enable_mixed_chunk = Some(false);
+    sg.mamba_state_capacity = Some(64);
+    let mut core = SglangCore::new(args);
+    let original: Vec<u32> = (0..1024).collect();
+    core.receive(direct_request(original.clone(), 1));
+    let mut now = 0.0;
+    while !core.is_empty() {
+        now = core.execute_pass_internal(None, now).end_ms;
+    }
+    let mut branch = original.clone();
+    branch[600] = 5000;
+    core.receive(direct_request(branch, 1));
+    while !core.is_empty() {
+        now = core.execute_pass_internal(None, now).end_ms;
+    }
+    // SGLang tracks the page-aligned branch inside the recomputed extend,
+    // rather than only its end. A later sibling can reuse that checkpoint.
+    assert_eq!(
+        core.kv_manager.cache().prefix_match_len(&original[..600]),
+        576
+    );
+}
+
+#[rstest]
+#[case(100, 320)]
+#[case(200, 512)]
+fn hybrid_completion_uses_the_last_tracked_decode_state(
+    #[case] outputs: u32,
+    #[case] cached: usize,
+) {
+    let mut args = test_args(128, 64, 256);
+    let sg = args.sglang.as_mut().unwrap();
+    sg.enable_mixed_chunk = Some(false);
+    sg.mamba_state_capacity = Some(64);
+    sg.mamba_track_interval = Some(256);
+    let mut core = SglangCore::new(args);
+    let mut request = direct_request((0..320).collect(), outputs as usize);
+    request.output_token_ids = Some((2000..2000 + outputs).collect());
+    core.receive(request);
+    let mut now = 0.0;
+    while !core.is_empty() {
+        now = core.execute_pass_internal(None, now).end_ms;
+    }
+    // Default SGLang decode tracking is every 256 tokens. Retain the prefill
+    // checkpoint until a decode forward actually reaches the 512 boundary.
+    let full: Vec<u32> = (0..320).chain(2000..2000 + outputs).collect();
+    assert_eq!(core.kv_manager.cache().prefix_match_len(&full), cached);
+}
