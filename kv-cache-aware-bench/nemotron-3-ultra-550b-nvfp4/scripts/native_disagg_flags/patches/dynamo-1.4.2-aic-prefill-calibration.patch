+}
+
+/// Optional shared calibration of native AIC forward-pass predictions.
+/// Defaults preserve AIC predictions exactly. These parameters never alter the
+/// scheduler, arrival clock, cache decisions, or reported benchmark metrics.
+#[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct AicCalibration {
+    pub prefill_scale: f64,
+    /// Additional attention cost, in milliseconds per billion causal Q/K pairs.
+    pub prefill_attention_ms_per_billion_pairs: f64,
+}
+
+impl Default for AicCalibration {
+    fn default() -> Self {
+        Self {
+            prefill_scale: 1.0,
+            prefill_attention_ms_per_billion_pairs: 0.0,
+        }
+    }
+}
+
+impl AicCalibration {
+    pub fn validate(&self) -> Result<()> {
+        anyhow::ensure!(
+            self.prefill_scale.is_finite() && self.prefill_scale > 0.0,
+            "AIC prefill_scale must be finite and positive"
+        );
+        anyhow::ensure!(
+            self.prefill_attention_ms_per_billion_pairs.is_finite()
+                && self.prefill_attention_ms_per_billion_pairs >= 0.0,
+            "AIC prefill_attention_ms_per_billion_pairs must be finite and nonnegative"
+        );
+        Ok(())
+    }
+}
+
+struct CalibratedAicCallback {
+    inner: Arc<dyn AicCallback>,
+    calibration: AicCalibration,
+}
+
+impl AicCallback for CalibratedAicCallback {
+    fn predict_prefill(
+        &self,
+        batch_size: usize,
+        effective_isl: usize,
+        prefix: usize,
+    ) -> Result<f64> {
+        let base = self
+            .inner
+            .predict_prefill(batch_size, effective_isl, prefix)?;
+        let query = effective_isl as f64;
+        // The prefix participates in attention but does not require another
+        // prefill. The pair cost is additive across successive prefill chunks.
+        let pairs = batch_size as f64 * query * (prefix as f64 + query / 2.0);
+        Ok(base * self.calibration.prefill_scale
+            + pairs / 1e9 * self.calibration.prefill_attention_ms_per_billion_pairs)
+    }
+
+    fn predict_decode(&self, batch_size: usize, isl: usize, osl: usize) -> Result<f64> {
+        self.inner.predict_decode(batch_size, isl, osl)
+    }
 }
 
