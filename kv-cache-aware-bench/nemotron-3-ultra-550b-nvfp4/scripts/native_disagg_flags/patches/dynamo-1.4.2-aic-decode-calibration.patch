     fn predict_decode(&self, batch_size: usize, isl: usize, osl: usize) -> Result<f64> {
-        self.inner.predict_decode(batch_size, isl, osl)
+        let base = self.inner.predict_decode(batch_size, isl, osl)?;
+        // AIC's first output comes from prefill. Only the remaining outputs
+        // invoke decode forwards; an empty batch has no additional work.
+        let steps = if batch_size == 0 {
+            0
+        } else {
+            osl.saturating_sub(1)
+        };
+        Ok(base
+            + steps as f64
+                * (self.calibration.decode_fixed_ms
+                    + batch_size as f64 * self.calibration.decode_ms_per_request))
     }
 }
 
