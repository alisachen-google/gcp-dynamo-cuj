+    kv_manager.cache_mut().enable_mamba_cache(10);
+    // A is oldest, B is next. With seven checkpoints the cold prefill fills
+    // the pool, so the speculative lookup's COW state must evict B.
+    let cached: Vec<Vec<u32>> = (0..cached_count)
+        .map(|i| (i * 100..i * 100 + 8).collect())
